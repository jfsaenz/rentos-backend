{
  "info": {
    "name": "RentOS Backend API",
    "description": "Coleccion de validacion para la entrega tecnica de RentOS. Ejecutar Register/Login antes de endpoints protegidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('service ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/ping"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('pong', () => pm.expect(pm.response.json().message).to.eql('pong'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('readiness responde', () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "pm.test('incluye checks', () => pm.expect(pm.response.json()).to.have.property('checks'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@rentos.com\",\n  \"password\": \"Password123!\",\n  \"nombre\": \"Demo RentOS\",\n  \"telefono\": \"3001234567\",\n  \"role\": \"admin\",\n  \"tenantId\": \"tenant-demo\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('registro creado o usuario existente', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@rentos.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('login exitoso', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "const token = body.token || body.access_token;",
                  "pm.test('token presente', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/auth/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('perfil protegido responde', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Core protegido",
      "item": [
        {
          "name": "Listar vehiculos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/vehiculos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('vehiculos responde', () => pm.expect([200, 401]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Crear vehiculo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"anio\": 2024,\n  \"placa\": \"RNT001\",\n  \"tipo\": \"sedan\",\n  \"estado\": \"disponible\",\n  \"precioDia\": 180000,\n  \"kilometraje\": 1200,\n  \"tenantId\": \"tenant-demo\"\n}"
            },
            "url": "{{baseUrl}}/vehiculos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('crear vehiculo responde', () => pm.expect([201, 400, 401]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/clientes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('clientes responde', () => pm.expect([200, 401]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Calcular tarifa",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precioBase\": 180000,\n  \"fechaInicio\": \"2026-06-01\",\n  \"fechaFin\": \"2026-06-05\",\n  \"vehiculoId\": 1,\n  \"tenantId\": \"tenant-demo\"\n}"
            },
            "url": "{{baseUrl}}/tarifas/calcular-precio"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('calculo responde', () => pm.expect([201, 400, 401]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Dashboard metricas",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/dashboard/metricas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('dashboard responde', () => pm.expect([200, 401]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "IA",
      "item": [
        {
          "name": "RAG chat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Que documentos necesito para alquilar un vehiculo?\"\n}"
            },
            "url": "{{baseUrl}}/rag/chat"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('rag responde', () => pm.expect([201, 401]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "" }
  ]
}
